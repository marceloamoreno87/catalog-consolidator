# Copie para .env e preencha os valores locais. Nunca versione sua chave real.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CATALOG_DATABASE=data/catalog.db
CATALOG_INPUT=data/ProductEntry.json
CATALOG_MATCH_THRESHOLD=0.72
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PROMPT_LABEL=local
LANGFUSE_RELEASE=local
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_MASK_SENSITIVE_DATA=true
